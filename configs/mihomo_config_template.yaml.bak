port: 12346
socks-port: 12347
mixed-port: 0
redir-port: 12348
allow-lan: true
bind-address: 0.0.0.0
mode: rule
log-level: warning
external-controller: 0.0.0.0:9999

sniffing:
  enable: true
  force-domain: []
  bypass-source:
  - 127.0.0.0/8

dns:
  enable: true
  listen: 0.0.0.0:1053
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
  - +*.github.com
  - +*.youtube.com
  - +*.googlevideo.com
  nameserver:
  - 8.8.8.8
  fallback:
  - 1.1.1.1

proxies:
- name: YOUR-MAIN-PROXY
  type: vless
  server: YOUR-PLACEHOLDER
  port: 443
  uuid: YOUR-PLACEHOLDER
  flow: ''
  network: ws
  tls: true
  sni: YOUR-PLACEHOLDER
  client-fingerprint: chrome
  ws-opts:
    path: /
    headers:
      Host: YOUR-PLACEHOLDER

proxy-groups:
- name: auto
  type: select
  proxies:
  - YOUR-MAIN-PROXY
  - DIRECT

rules:
  # 📺 僅指定電視盒子 (192.168.31.39) 觀看 YouTube 走代理
  - SRC-IP-CIDR,192.168.31.39/32,auto
  
  # 🌍 其他所有流量 100% 走原生直連
  - MATCH,DIRECT
